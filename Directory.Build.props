<Project>
  <PropertyGroup>
    <Version>0.12.0</Version>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Product>NACHO</Product>
    <Company>NACHO</Company>
    <Copyright>Idea: Csaba Kovacs</Copyright>
    <Deterministic>true</Deterministic>
    <!-- Builds record /_/ instead of the folder they were built in, so no local path ends up in a release. -->
    <PathMap>$(MSBuildThisFileDirectory)=/_/</PathMap>
  </PropertyGroup>
</Project>
