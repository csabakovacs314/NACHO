[Desktop Entry]
Type=Application
Name=NACHO
GenericName=Docs-ready images
Comment=Normalise, Adjust, Compress, Hand Over
Exec=nacho %F
Icon=nacho
Terminal=false
Categories=Graphics;2DGraphics;RasterGraphics;
Keywords=image;photo;resize;shrink;compress;docs;
MimeType=image/jpeg;image/png;image/gif;image/heic;image/heif;image/webp;image/avif;image/tiff;image/bmp;
X-AppImage-Version=@VERSION@
