<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="using:Nacho.Linux"
        x:Class="Nacho.Linux.AboutWindow"
        Title="{l:L About.Title}" Width="640" SizeToContent="Height" MinWidth="420" MaxHeight="820"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" CanResize="False">
    <Window.Styles>
        <Style Selector="Border.card">
            <Setter Property="Margin" Value="0,0,0,14" />
            <Setter Property="Padding" Value="18,16" />
        </Style>
        <Style Selector="TextBlock.body">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="LineHeight" Value="19" />
        </Style>
        <Style Selector="TextBlock.sub">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
    </Window.Styles>

    <Grid x:Name="Root" RowDefinitions="*,Auto">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="True">
            <StackPanel Margin="24,22,24,10">
                <DockPanel Margin="0,0,0,14">
                    <l:Logo DockPanel.Dock="Left" Width="64" Height="64" VerticalAlignment="Top" AutomationProperties.Name="NACHO" />
                    <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="NACHO" FontSize="26" FontWeight="Bold" />
                        <TextBlock Text="{l:L App.Expansion}" FontSize="14" TextWrapping="Wrap" />
                        <TextBlock x:Name="OtherExpansion" Classes="secondary" FontStyle="Italic" FontSize="12" TextWrapping="Wrap" />
                    </StackPanel>
                </DockPanel>

                <!-- Version: neutral until checked, then green (newest), blue (newer one out) or amber (could not check) -->
                <Border x:Name="VersionStrip" Padding="14,8" Margin="0,0,0,14" CornerRadius="6" BorderThickness="1"
                        Background="{DynamicResource N.Card}" BorderBrush="{DynamicResource N.CardStroke}">
                    <DockPanel>
                        <l:StrokeIcon x:Name="VersionIcon" DockPanel.Dock="Left" Data="{StaticResource Icon.Info}" Width="18" Height="18" Margin="0,0,12,0"
                                      VerticalAlignment="Center" Foreground="{DynamicResource N.TextSecondary}" />
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
                            <Button x:Name="ReleaseButton" Classes="accent" Content="{l:L Update.Open}" Click="Release_Click" Padding="12,5" IsVisible="False" />
                            <Button x:Name="CheckButton" Content="{l:L Update.CheckNow}" Click="Check_Click" Padding="12,5" />
                        </StackPanel>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                            <TextBlock x:Name="VersionText" FontSize="13" FontWeight="SemiBold" />
                            <TextBlock x:Name="CheckText" Classes="body" IsVisible="False" AutomationProperties.LiveSetting="Polite" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <Border Classes="card" BorderThickness="2" BorderBrush="{DynamicResource N.Accent}" Padding="17,15">
                    <StackPanel>
                        <TextBlock Text="{l:L About.Google}" Classes="heading" />
                        <TextBlock Text="{l:L About.GoogleBody}" Classes="body" />
                    </StackPanel>
                </Border>

                <Border Classes="card">
                    <StackPanel>
                        <TextBlock Text="{l:L About.How}" Classes="heading" />
                        <StackPanel x:Name="WaysList" />
                    </StackPanel>
                </Border>

                <Border Classes="card">
                    <StackPanel>
                        <TextBlock Text="{l:L About.Replace}" Classes="sub" />
                        <TextBlock Text="{l:L About.ReplaceBody}" Classes="body" Margin="0,0,0,12" />
                        <TextBlock Text="{l:L About.Doc}" Classes="sub" />
                        <TextBlock Text="{l:L About.DocBody}" Classes="body" Margin="0,0,0,12" />
                        <TextBlock Text="{l:L About.Pdf}" Classes="sub" />
                        <TextBlock Text="{l:L About.PdfBody}" Classes="body" />
                    </StackPanel>
                </Border>

                <Border Classes="card">
                    <StackPanel>
                        <TextBlock Text="{l:L About.Keys}" Classes="heading" />
                        <UniformGrid x:Name="KeysGrid" Columns="2" />
                    </StackPanel>
                </Border>

                <WrapPanel Margin="2,2,0,0">
                    <TextBlock Text="{l:L About.Credits}" Classes="secondary" FontSize="12" VerticalAlignment="Center" />
                    <TextBlock Text=" · " Classes="secondary" FontSize="12" VerticalAlignment="Center" />
                    <Button x:Name="PrivacyLink" Classes="link" Content="{l:L About.Privacy}" Click="Privacy_Click" FontSize="12" Padding="2,0" MinHeight="24" />
                </WrapPanel>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1" Classes="cmdbar">
            <DockPanel>
                <Button DockPanel.Dock="Left" Content="{l:L About.OpenFolder}" Click="OpenFolder_Click" Padding="12,4" />
                <Button DockPanel.Dock="Right" Content="{l:L About.Close}" IsDefault="True" IsCancel="True" Click="Close_Click" MinWidth="96" Padding="12,4"
                        HorizontalAlignment="Right" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
