<Project Sdk="Microsoft.NET.Sdk">
  <!-- NACHO for Linux: an Avalonia window on the same engine and texts as the Windows app. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>nacho</AssemblyName>
    <RootNamespace>Nacho.Linux</RootNamespace>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationManifest />
    <!-- Avalonia's XAML step rewrites this assembly and would keep the build folder in its debug path,
         so Release builds carry no debug symbols. -->
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.4" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Nacho.Core\Nacho.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Assets\nacho.svg" LogicalName="nacho.svg" />
    <EmbeddedResource Include="Assets\nacho.png" LogicalName="nacho.png" />
    <!-- oxipng (MIT), unpacked once to ~/.cache/nacho/tools; see tools/oxipng/README.md. -->
    <EmbeddedResource Include="..\..\tools\oxipng\linux-x64\oxipng" LogicalName="oxipng" />
  </ItemGroup>
</Project>
