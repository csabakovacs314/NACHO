<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="using:Nacho.Linux"
        x:Class="Nacho.Linux.CompareWindow"
        Width="1100" Height="780" MinWidth="460" MinHeight="420"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Window.Styles>
        <Style Selector="RadioButton.segment">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="MinWidth" Value="56" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Margin" Value="0,0,2,0" />
        </Style>
        <Style Selector="Border.chip">
            <Setter Property="Background" Value="#E6202020" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>
        <Style Selector="Border#Viewport:focus-visible">
            <Setter Property="BorderBrush" Value="{DynamicResource N.Accent}" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>
    </Window.Styles>

    <Grid x:Name="Root" RowDefinitions="Auto,*,Auto,Auto">
        <!-- Command bar: zoom, right side, close -->
        <DockPanel Grid.Row="0" Margin="12,10,12,6">
            <Button DockPanel.Dock="Right" Content="{l:L Compare.Close}" Click="Close_Click" IsCancel="True"
                    MinHeight="32" MinWidth="88" Padding="12,4" Margin="4" VerticalAlignment="Top" />
            <WrapPanel Orientation="Horizontal">
                <TextBlock Text="{l:L Compare.Zoom}" Classes="secondary" VerticalAlignment="Center" Margin="4,0,6,0" />
                <StackPanel Orientation="Horizontal" Margin="0,4,12,4" AutomationProperties.Name="{l:L Compare.Zoom}">
                    <RadioButton x:Name="ZoomFit" Tag="0" GroupName="Zoom" Content="{l:L Compare.Fit}" Classes="segment" ToolTip.Tip="0"
                                 Theme="{StaticResource {x:Type ToggleButton}}" IsCheckedChanged="Zoom_Changed" />
                    <RadioButton x:Name="Zoom100" Tag="1" GroupName="Zoom" Content="100%" Classes="segment" ToolTip.Tip="{l:L Compare.ActualPixels}"
                                 Theme="{StaticResource {x:Type ToggleButton}}" IsCheckedChanged="Zoom_Changed" />
                    <RadioButton x:Name="Zoom200" Tag="2" GroupName="Zoom" Content="200%" Classes="segment" ToolTip.Tip="2"
                                 Theme="{StaticResource {x:Type ToggleButton}}" IsCheckedChanged="Zoom_Changed" />
                    <RadioButton x:Name="Zoom400" Tag="4" GroupName="Zoom" Content="400%" Classes="segment" ToolTip.Tip="4"
                                 Theme="{StaticResource {x:Type ToggleButton}}" IsCheckedChanged="Zoom_Changed" />
                </StackPanel>
                <StackPanel x:Name="RightGroup" Orientation="Horizontal" IsVisible="False">
                    <TextBlock Text="{l:L Compare.Right}" Classes="secondary" VerticalAlignment="Center" Margin="4,0,6,0" />
                    <StackPanel Orientation="Horizontal" Margin="0,4,4,4" AutomationProperties.Name="{l:L Compare.Right}">
                        <RadioButton x:Name="ShowCopy" GroupName="Right" Content="{l:L Compare.ShowCopy}" Classes="segment" IsChecked="True"
                                     Theme="{StaticResource {x:Type ToggleButton}}" IsCheckedChanged="Right_Changed" />
                        <RadioButton x:Name="ShowPalette" GroupName="Right" Content="{l:L Compare.ShowPalette}" Classes="segment"
                                     Theme="{StaticResource {x:Type ToggleButton}}" IsCheckedChanged="Right_Changed" />
                    </StackPanel>
                </StackPanel>
            </WrapPanel>
        </DockPanel>

        <!-- The picture: copy underneath, original on top and cut off at the divider -->
        <Border x:Name="Viewport" Grid.Row="1" Margin="12,0,12,8" ClipToBounds="True" Focusable="True"
                BorderThickness="1" BorderBrush="{DynamicResource N.CardStroke}" Background="{DynamicResource N.Subtle}"
                AutomationProperties.Name="{l:L Compare.Area}">
            <Canvas x:Name="Stage" Background="Transparent">
                <Rectangle x:Name="CheckerBack" />
                <Image x:Name="RightImage" Stretch="Fill" />
                <Image x:Name="LeftImage" Stretch="Fill" />
                <Rectangle x:Name="LineDark" Width="4" Fill="#202020" />
                <Rectangle x:Name="LineLight" Width="2" Fill="White" />
                <Grid x:Name="Handle" Width="36" Height="36">
                    <Ellipse Fill="White" Stroke="#202020" StrokeThickness="2" />
                    <l:StrokeIcon Data="{StaticResource Icon.Chevrons}" Foreground="#202020" Width="16" Height="16"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
                <Border x:Name="LeftChip" Classes="chip">
                    <TextBlock x:Name="LeftChipText" Foreground="White" FontSize="13" />
                </Border>
                <Border x:Name="RightChip" Classes="chip">
                    <TextBlock x:Name="RightChipText" Foreground="White" FontSize="13" />
                </Border>
                <TextBlock x:Name="LoadingText" Text="{l:L Compare.Loading}" FontSize="15" TextWrapping="Wrap" />
            </Canvas>
        </Border>

        <!-- The divider as a slider: keyboard and screen readers -->
        <DockPanel Grid.Row="2" Margin="16,0,16,6">
            <TextBlock DockPanel.Dock="Left" Text="{l:L Compare.Original}" VerticalAlignment="Center" Margin="0,0,10,0" />
            <TextBlock DockPanel.Dock="Right" x:Name="RightName" VerticalAlignment="Center" Margin="10,0,0,0" />
            <Slider x:Name="Divider" Minimum="0" Maximum="100" Value="50" SmallChange="2" LargeChange="10"
                    VerticalAlignment="Center" AutomationProperties.Name="{l:L Compare.Divider}" />
        </DockPanel>

        <Border Grid.Row="3" Padding="16,8,16,10" BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource N.Divider}" Background="{DynamicResource N.Layer}">
            <StackPanel>
                <TextBlock x:Name="SizeNote" FontSize="13" TextWrapping="Wrap" />
                <TextBlock x:Name="PaletteNote" FontSize="13" TextWrapping="Wrap" Margin="0,4,0,0" IsVisible="False" />
                <TextBlock Text="{l:L Compare.Hint}" Classes="secondary" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
