<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Nacho.Linux.App"
             Name="NACHO"
             RequestedThemeVariant="Default">
    <Application.Resources>
        <ResourceDictionary>
            <!-- NACHO's own colours. Every text pair meets WCAG 2.2 AA (4.5:1) on its background. -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="N.Text" Color="#1A1A1A" />
                    <SolidColorBrush x:Key="N.TextSecondary" Color="#5D5D5D" />
                    <SolidColorBrush x:Key="N.Window" Color="#F3F3F3" />
                    <SolidColorBrush x:Key="N.Card" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="N.CardStroke" Color="#E0E0E0" />
                    <SolidColorBrush x:Key="N.Subtle" Color="#F0F0F0" />
                    <SolidColorBrush x:Key="N.StrongStroke" Color="#8A8A8A" />
                    <SolidColorBrush x:Key="N.Divider" Color="#E0E0E0" />
                    <SolidColorBrush x:Key="N.Layer" Color="#FAFAFA" />
                    <SolidColorBrush x:Key="N.Accent" Color="#005FB8" />
                    <SolidColorBrush x:Key="N.Success" Color="#0A6B0A" />
                    <SolidColorBrush x:Key="N.Critical" Color="#B42619" />
                    <!-- Light buttons with a thin border, like Windows 11 and the mockup, instead of Avalonia's grey. -->
                    <SolidColorBrush x:Key="ButtonBackground" Color="#FBFBFB" />
                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#F4F4F4" />
                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#EDEDED" />
                    <SolidColorBrush x:Key="ButtonBorderBrush" Color="#C8C8C8" />
                    <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#B4B4B4" />
                    <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#C8C8C8" />
                    <SolidColorBrush x:Key="ToggleButtonBackground" Color="#FBFBFB" />
                    <SolidColorBrush x:Key="ToggleButtonBackgroundPointerOver" Color="#F4F4F4" />
                    <SolidColorBrush x:Key="ToggleButtonBackgroundPressed" Color="#EDEDED" />
                    <SolidColorBrush x:Key="ToggleButtonBorderBrush" Color="#C8C8C8" />
                    <SolidColorBrush x:Key="ToggleButtonBorderBrushPointerOver" Color="#B4B4B4" />
                    <SolidColorBrush x:Key="ToggleButtonBorderBrushPressed" Color="#C8C8C8" />
                    <!-- A quiet selection, so grey and green tile text keep 4.5:1 on a selected tile. -->
                    <SolidColorBrush x:Key="SystemControlHighlightListAccentLowBrush" Color="#E3EEF9" />
                    <SolidColorBrush x:Key="SystemControlHighlightListAccentMediumBrush" Color="#D6E6F6" />
                    <SolidColorBrush x:Key="SystemControlHighlightListAccentHighBrush" Color="#C9DEF3" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="N.Text" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="N.TextSecondary" Color="#C5C5C5" />
                    <SolidColorBrush x:Key="N.Window" Color="#202020" />
                    <SolidColorBrush x:Key="N.Card" Color="#2B2B2B" />
                    <SolidColorBrush x:Key="N.CardStroke" Color="#3D3D3D" />
                    <SolidColorBrush x:Key="N.Subtle" Color="#333333" />
                    <SolidColorBrush x:Key="N.StrongStroke" Color="#9A9A9A" />
                    <SolidColorBrush x:Key="N.Divider" Color="#3D3D3D" />
                    <SolidColorBrush x:Key="N.Layer" Color="#272727" />
                    <SolidColorBrush x:Key="N.Accent" Color="#60CDFF" />
                    <SolidColorBrush x:Key="N.Success" Color="#6CCB5F" />
                    <SolidColorBrush x:Key="N.Critical" Color="#FF99A4" />
                    <SolidColorBrush x:Key="ButtonBackground" Color="#2D2D2D" />
                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#353535" />
                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#282828" />
                    <SolidColorBrush x:Key="ButtonBorderBrush" Color="#4A4A4A" />
                    <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#5A5A5A" />
                    <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#4A4A4A" />
                    <SolidColorBrush x:Key="ToggleButtonBackground" Color="#2D2D2D" />
                    <SolidColorBrush x:Key="ToggleButtonBackgroundPointerOver" Color="#353535" />
                    <SolidColorBrush x:Key="ToggleButtonBackgroundPressed" Color="#282828" />
                    <SolidColorBrush x:Key="ToggleButtonBorderBrush" Color="#4A4A4A" />
                    <SolidColorBrush x:Key="ToggleButtonBorderBrushPointerOver" Color="#5A5A5A" />
                    <SolidColorBrush x:Key="ToggleButtonBorderBrushPressed" Color="#4A4A4A" />
                    <SolidColorBrush x:Key="SystemControlHighlightListAccentLowBrush" Color="#2F3B47" />
                    <SolidColorBrush x:Key="SystemControlHighlightListAccentMediumBrush" Color="#364452" />
                    <SolidColorBrush x:Key="SystemControlHighlightListAccentHighBrush" Color="#3D4C5C" />
                    <!-- The dark accent is light blue, so text on it is black (12:1), never white. -->
                    <SolidColorBrush x:Key="AccentButtonForeground" Color="#000000" />
                    <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="#000000" />
                    <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="#000000" />
                    <SolidColorBrush x:Key="ToggleButtonForegroundChecked" Color="#000000" />
                    <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPointerOver" Color="#000000" />
                    <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPressed" Color="#000000" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <Thickness x:Key="ButtonBorderThemeThickness">1</Thickness>
            <Thickness x:Key="ToggleButtonBorderThemeThickness">1</Thickness>

            <!-- 16 x 16 line icons, drawn with the text colour by StrokeIcon. -->
            <StreamGeometry x:Key="Icon.Add">M8,2.5 V13.5 M2.5,8 H13.5</StreamGeometry>
            <StreamGeometry x:Key="Icon.Paste">M5.5,2 H10.5 V4.5 H5.5 Z M5.5,3.25 H4 A1.5,1.5 0 0 0 2.5,4.75 V13 A1.5,1.5 0 0 0 4,14.5 H12 A1.5,1.5 0 0 0 13.5,13 V4.75 A1.5,1.5 0 0 0 12,3.25 H10.5</StreamGeometry>
            <StreamGeometry x:Key="Icon.Options">M2,4.5 H14 M2,11.5 H14 M5.5,2.75 V6.25 M10.5,9.75 V13.25</StreamGeometry>
            <StreamGeometry x:Key="Icon.Undo">M5.5,3 L2.5,6 L5.5,9 M2.5,6 H10 A3.5,3.5 0 0 1 10,13 H6.5</StreamGeometry>
            <StreamGeometry x:Key="Icon.Help">M5.75,6 A2.25,2.25 0 1 1 8.6,8.2 C8.1,8.45 8,8.8 8,9.6 M8,12.25 V12.5</StreamGeometry>
            <StreamGeometry x:Key="Icon.Globe">M8,1.5 A6.5,6.5 0 1 1 7.99,1.5 Z M1.5,8 H14.5 M8,1.5 C5.5,4 5.5,12 8,14.5 M8,1.5 C10.5,4 10.5,12 8,14.5</StreamGeometry>
            <StreamGeometry x:Key="Icon.Drop">M8,1.5 V9.5 M4.75,6.25 L8,9.5 L11.25,6.25 M2,10.5 V14 H14 V10.5</StreamGeometry>
            <StreamGeometry x:Key="Icon.Document">M4,1.5 H9.5 L12.5,4.5 V14.5 H4 Z M9.5,1.5 V4.5 H12.5 M6,8 H10.5 M6,10.5 H10.5 M6,13 H9</StreamGeometry>
            <StreamGeometry x:Key="Icon.Compare">M2.5,3 H13.5 V13 H2.5 Z M8,1.5 V14.5 M4.25,8 H6.25 M9.75,8 H11.75</StreamGeometry>
            <StreamGeometry x:Key="Icon.Info">M8,1.5 A6.5,6.5 0 1 1 7.99,1.5 Z M8,7.25 V11.5 M8,4.75 V5</StreamGeometry>
            <StreamGeometry x:Key="Icon.Chevrons">M6,4.5 L2.5,8 L6,11.5 M10,4.5 L13.5,8 L10,11.5</StreamGeometry>
            <StreamGeometry x:Key="Icon.Error">M8,1.5 A6.5,6.5 0 1 1 7.99,1.5 Z M5.75,5.75 L10.25,10.25 M10.25,5.75 L5.75,10.25</StreamGeometry>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme>
            <!-- The same blue as the Windows app; white text on it is 6.5:1. -->
            <FluentTheme.Palettes>
                <ColorPaletteResources x:Key="Light" Accent="#005FB8" />
                <ColorPaletteResources x:Key="Dark" Accent="#60CDFF" />
            </FluentTheme.Palettes>
        </FluentTheme>
        <Style Selector="Window">
            <Setter Property="Background" Value="{DynamicResource N.Window}" />
            <Setter Property="Foreground" Value="{DynamicResource N.Text}" />
        </Style>
        <Style Selector="TextBlock.secondary">
            <Setter Property="Foreground" Value="{DynamicResource N.TextSecondary}" />
        </Style>
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{DynamicResource N.Card}" />
            <Setter Property="BorderBrush" Value="{DynamicResource N.CardStroke}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16" />
        </Style>
        <Style Selector="Button">
            <Setter Property="MinHeight" Value="32" />
        </Style>
    </Application.Styles>
</Application>
