<Window x:Class="Nacho.GoogleDocWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:Nacho"
        Title="{l:L Gd.Title}" Width="720" Height="860" MinWidth="480" MinHeight="520"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="True">
    <Window.TaskbarItemInfo>
        <TaskbarItemInfo x:Name="Taskbar" />
    </Window.TaskbarItemInfo>
    <Window.Resources>
        <FontFamily x:Key="Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
        <Style x:Key="Secondary" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Padding" Value="16,14" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
        </Style>
        <Style x:Key="Chip" TargetType="Border">
            <Setter Property="Padding" Value="10,3" />
            <Setter Property="Margin" Value="0,0,8,6" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
        </Style>
        <Style x:Key="Icon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Icons}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="LinkButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Window.Resources>

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer x:Name="Scroller" Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="28,18,28,12">

                <!-- H1: where am I, what comes next. Built in code (five steps, four lines). -->
                <Grid x:Name="StepsGrid" Margin="0,0,0,16" AutomationProperties.Name="{l:L Gd.Steps}" />

                <!-- What NACHO may change right now (shown while nothing can change) -->
                <Border x:Name="SafeBar" Padding="14,10" CornerRadius="6" BorderThickness="1" Margin="0,0,0,14"
                        Background="{DynamicResource SystemFillColorSuccessBackgroundBrush}" BorderBrush="{DynamicResource SystemFillColorSuccessBrush}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="&#xEA18;" FontSize="18" Margin="0,0,12,0"
                                   Foreground="{DynamicResource SystemFillColorSuccessBrush}" />
                        <Border DockPanel.Dock="Right" CornerRadius="10" BorderThickness="1" Padding="10,2" Margin="12,0,0,0" VerticalAlignment="Center"
                                BorderBrush="{DynamicResource SystemFillColorSuccessBrush}" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                            <TextBlock x:Name="SafeTag" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SystemFillColorSuccessBrush}" />
                        </Border>
                        <TextBlock x:Name="SafeText" FontSize="13" TextWrapping="Wrap" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" />
                    </DockPanel>
                </Border>

                <!-- Who is signed in -->
                <Border x:Name="AccountCard" Style="{StaticResource Card}" Padding="14,10" Margin="0,0,0,14">
                    <DockPanel>
                        <Button x:Name="OtherAccountButton" DockPanel.Dock="Right" Content="{l:L Gd.OtherAccount}" Click="OtherAccount_Click"
                                MinHeight="32" Padding="12,4" Margin="12,0,0,0" VerticalAlignment="Center" />
                        <Border DockPanel.Dock="Left" Width="32" Height="32" CornerRadius="16" Margin="0,0,12,0" Background="{DynamicResource AccentFillColorDefaultBrush}">
                            <TextBlock x:Name="AccountInitial" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="14"
                                       Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                        </Border>
                        <TextBlock x:Name="AccountText" VerticalAlignment="Center" TextWrapping="Wrap" FontSize="14" AutomationProperties.LiveSetting="Polite" />
                    </DockPanel>
                </Border>

                <!-- 1 Choose -->
                <StackPanel x:Name="ChoosePanel">
                    <Border Style="{StaticResource Card}" Padding="22,20" Margin="0,0,0,16">
                        <DockPanel>
                            <Border DockPanel.Dock="Left" Width="60" Height="74" CornerRadius="6" Margin="0,0,20,0" VerticalAlignment="Top"
                                    Background="{DynamicResource SubtleFillColorSecondaryBrush}" BorderThickness="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE8B9;" FontSize="30" HorizontalAlignment="Center"
                                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                            </Border>
                            <StackPanel>
                                <TextBlock Text="{l:L Gd.Which}" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,6" AutomationProperties.HeadingLevel="Level1" />
                                <TextBlock Text="{l:L Gd.ChooseHint}" FontSize="14" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,12" />
                                <Button x:Name="ChooseButton" Content="{l:L Gd.Choose}" Click="Choose_Click" HorizontalAlignment="Left"
                                        MinHeight="40" Padding="20,6" FontSize="14" FontWeight="SemiBold" Style="{DynamicResource AccentButtonStyle}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <Label Content="{l:L Gd.LinkLabel}" Target="{Binding ElementName=LinkBox}" Padding="0" Margin="2,0,0,6" FontWeight="SemiBold" FontSize="14" />
                    <DockPanel Margin="2,0,2,0">
                        <Button x:Name="CheckLinkButton" DockPanel.Dock="Right" Content="{l:L Gd.CheckLink}" Click="CheckLink_Click" MinHeight="34" Padding="14,4" Margin="8,0,0,0" />
                        <TextBox x:Name="LinkBox" TextChanged="LinkBox_TextChanged" MinHeight="34" VerticalContentAlignment="Center"
                                 AutomationProperties.HelpText="{l:L Gd.LinkHint}" />
                    </DockPanel>
                    <TextBlock Text="{l:L Gd.LinkHint}" Style="{StaticResource Secondary}" Margin="2,6,0,0" />
                    <TextBlock x:Name="LinkError" Visibility="Collapsed" TextWrapping="Wrap" Margin="2,6,0,0" FontSize="13"
                               Foreground="{DynamicResource SystemFillColorCriticalBrush}" AutomationProperties.LiveSetting="Assertive" />

                    <StackPanel x:Name="RecentPanel" Margin="0,18,0,0">
                        <TextBlock Text="{l:L Gd.Recent}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8" AutomationProperties.HeadingLevel="Level2" />
                        <StackPanel x:Name="RecentList" />
                    </StackPanel>

                    <WrapPanel Margin="0,18,0,0">
                        <Border Style="{StaticResource Chip}"><TextBlock x:Name="PresetChip" FontSize="12" /></Border>
                        <Border Style="{StaticResource Chip}"><TextBlock x:Name="OriginalsChip" FontSize="12" /></Border>
                        <Button Style="{StaticResource LinkButton}" Content="{l:L Gd.Change}" Click="Change_Click" FontSize="12" Margin="0,0,0,6" />
                    </WrapPanel>
                </StackPanel>

                <!-- The Doc being worked on (steps 2 and 3) -->
                <Border x:Name="DocCard" Style="{StaticResource Card}" Margin="0,0,0,14" Visibility="Collapsed">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="{l:L Gd.OpenBrowser}" Click="OpenOriginal_Click" VerticalAlignment="Center" />
                        <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="&#xE8A5;" FontSize="24" Margin="0,0,14,0"
                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                        <StackPanel>
                            <TextBlock x:Name="DocTitle" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock x:Name="DocInfo" Style="{StaticResource Secondary}" Margin="0,2,0,0" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- 2 Check -->
                <StackPanel x:Name="CheckPanel" Visibility="Collapsed">
                    <Border Style="{StaticResource Card}" Padding="18,16" Margin="0,0,0,14">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,10">
                                <TextBlock x:Name="CheckLeft" DockPanel.Dock="Right" Style="{StaticResource Secondary}" FontSize="13" VerticalAlignment="Bottom" />
                                <TextBlock x:Name="CheckTitle" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"
                                           AutomationProperties.HeadingLevel="Level1" />
                            </DockPanel>
                            <ProgressBar x:Name="CheckBar" Height="8" Minimum="0" Maximum="1" Margin="0,0,0,12"
                                         AutomationProperties.LabeledBy="{Binding ElementName=CheckTitle}" />
                            <UniformGrid x:Name="Tiles" Columns="24" Margin="0,0,0,10" Focusable="False" />
                            <WrapPanel x:Name="Legend" Margin="0,0,0,6" />
                            <Border x:Name="LastBorder" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" Padding="0,8,0,0">
                                <TextBlock x:Name="LastLine" FontSize="13" TextWrapping="Wrap" />
                            </Border>
                        </StackPanel>
                    </Border>
                    <UniformGrid x:Name="ResourceGrid" Columns="2" Margin="0,0,0,10">
                        <Border Style="{StaticResource Card}" Padding="14,10" Margin="0,0,6,0">
                            <StackPanel>
                                <TextBlock Text="{l:L Gd.Space}" Style="{StaticResource Secondary}" />
                                <TextBlock x:Name="SpaceText" FontSize="14" TextWrapping="Wrap" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Padding="14,10" Margin="6,0,0,0">
                            <StackPanel>
                                <TextBlock Text="{l:L Gd.Conn}" Style="{StaticResource Secondary}" />
                                <TextBlock x:Name="ConnText" FontSize="14" TextWrapping="Wrap" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                    <TextBlock Text="{l:L Gd.KeepUsing}" Style="{StaticResource Secondary}" />
                </StackPanel>

                <!-- 3 Decide -->
                <StackPanel x:Name="DecidePanel" Visibility="Collapsed">
                    <Border Style="{StaticResource Card}" Padding="18,14" Margin="0,0,0,14">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,10">
                                <TextBlock x:Name="CheckedAt" DockPanel.Dock="Right" Style="{StaticResource Secondary}" VerticalAlignment="Bottom" Margin="10,0,0,0" />
                                <TextBlock x:Name="ResultTitle" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" AutomationProperties.HeadingLevel="Level1" />
                            </DockPanel>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" MinWidth="64" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" MinWidth="80" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="{l:L Gd.BarNow}" Style="{StaticResource Secondary}" FontSize="13" VerticalAlignment="Center" Margin="0,0,10,6" />
                                <Border Grid.Column="1" Height="14" CornerRadius="3" Margin="0,0,10,6" Background="{DynamicResource ControlStrongStrokeColorDefaultBrush}" />
                                <TextBlock x:Name="BeforeText" Grid.Column="2" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Right" Margin="0,0,0,6" />
                                <TextBlock Grid.Row="1" Text="{l:L Gd.BarAfter}" Style="{StaticResource Secondary}" FontSize="13" VerticalAlignment="Center" Margin="0,0,10,0" />
                                <Grid x:Name="AfterBar" Grid.Row="1" Grid.Column="1" Margin="0,0,10,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="5*" />
                                        <ColumnDefinition Width="95*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Height="14" CornerRadius="3" MinWidth="6" Background="{DynamicResource SystemFillColorSuccessBrush}" />
                                </Grid>
                                <TextBlock x:Name="AfterText" Grid.Row="1" Grid.Column="2" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Right"
                                           Foreground="{DynamicResource SystemFillColorSuccessBrush}" />
                            </Grid>
                            <WrapPanel x:Name="CountChips" />
                            <Expander x:Name="AllPictures" Header="{l:L Gd.SeeAll}" Margin="0,4,0,0" Expanded="AllPictures_Expanded">
                                <ListBox x:Name="PictureList" MaxHeight="220" Margin="0,6,0,0" BorderThickness="0"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="{l:L Gd.SeeAll}" />
                            </Expander>
                        </StackPanel>
                    </Border>

                    <TextBlock x:Name="NothingText" Text="{l:L Gd.Nothing}" Visibility="Collapsed" TextWrapping="Wrap" FontSize="14" Margin="0,0,0,12" />

                    <StackPanel x:Name="WherePanel">
                        <TextBlock Text="{l:L Gd.WhereQ}" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8" AutomationProperties.HeadingLevel="Level2" />
                        <Border x:Name="CopyCard" CornerRadius="8" Margin="0,0,0,10" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                            <RadioButton x:Name="CopyRadio" GroupName="Dest" Checked="Dest_Checked" Padding="8,0,0,0" Margin="16,12"
                                         HorizontalContentAlignment="Stretch" AutomationProperties.HelpText="{l:L Gd.CopyPro1}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Text="{l:L Gd.IntoCopy}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        <Border CornerRadius="10" Padding="8,1" Margin="10,0,0,0" VerticalAlignment="Center" Background="{DynamicResource AccentFillColorDefaultBrush}">
                                            <TextBlock Text="{l:L Gd.Recommended}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock x:Name="CopySub" Style="{StaticResource Secondary}" FontSize="13" Margin="0,0,0,8" />
                                    <UniformGrid Columns="2">
                                        <DockPanel Margin="0,0,10,4"><TextBlock Style="{StaticResource Icon}" Text="&#xE73E;" Margin="0,0,6,0" Foreground="{DynamicResource SystemFillColorSuccessBrush}" /><TextBlock Text="{l:L Gd.CopyPro1}" FontSize="13" TextWrapping="Wrap" /></DockPanel>
                                        <DockPanel Margin="0,0,0,4"><TextBlock Style="{StaticResource Icon}" Text="&#xE73E;" Margin="0,0,6,0" Foreground="{DynamicResource SystemFillColorSuccessBrush}" /><TextBlock Text="{l:L Gd.CopyPro2}" FontSize="13" TextWrapping="Wrap" /></DockPanel>
                                        <DockPanel Margin="0,0,10,0"><TextBlock Style="{StaticResource Icon}" Text="&#xE946;" Margin="0,0,6,0" Foreground="{DynamicResource SystemFillColorCautionBrush}" /><TextBlock Text="{l:L Gd.CopyCon1}" FontSize="13" TextWrapping="Wrap" /></DockPanel>
                                        <DockPanel><TextBlock Style="{StaticResource Icon}" Text="&#xE946;" Margin="0,0,6,0" Foreground="{DynamicResource SystemFillColorCautionBrush}" /><TextBlock Text="{l:L Gd.CopyCon2}" FontSize="13" TextWrapping="Wrap" /></DockPanel>
                                    </UniformGrid>
                                </StackPanel>
                            </RadioButton>
                        </Border>
                        <Border x:Name="DocChoiceCard" CornerRadius="8" Margin="0,0,0,12" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                            <RadioButton x:Name="DocRadio" GroupName="Dest" Checked="Dest_Checked" Padding="8,0,0,0" Margin="16,12"
                                         HorizontalContentAlignment="Stretch" AutomationProperties.HelpText="{l:L Gd.DocPro1}">
                                <StackPanel>
                                    <TextBlock Text="{l:L Gd.IntoDoc}" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,4" />
                                    <TextBlock Text="{l:L Gd.IntoDocSub}" Style="{StaticResource Secondary}" FontSize="13" Margin="0,0,0,8" />
                                    <UniformGrid Columns="2">
                                        <DockPanel Margin="0,0,10,4"><TextBlock Style="{StaticResource Icon}" Text="&#xE73E;" Margin="0,0,6,0" Foreground="{DynamicResource SystemFillColorSuccessBrush}" /><TextBlock Text="{l:L Gd.DocPro1}" FontSize="13" TextWrapping="Wrap" /></DockPanel>
                                        <DockPanel Margin="0,0,0,4"><TextBlock Style="{StaticResource Icon}" Text="&#xE73E;" Margin="0,0,6,0" Foreground="{DynamicResource SystemFillColorSuccessBrush}" /><TextBlock Text="{l:L Gd.DocPro2}" FontSize="13" TextWrapping="Wrap" /></DockPanel>
                                        <DockPanel Margin="0,0,10,0"><TextBlock Style="{StaticResource Icon}" Text="&#xE946;" Margin="0,0,6,0" Foreground="{DynamicResource SystemFillColorCautionBrush}" /><TextBlock Text="{l:L Gd.DocCon1}" FontSize="13" TextWrapping="Wrap" /></DockPanel>
                                        <DockPanel><TextBlock Style="{StaticResource Icon}" Text="&#xE946;" Margin="0,0,6,0" Foreground="{DynamicResource SystemFillColorCautionBrush}" /><TextBlock Text="{l:L Gd.DocCon2}" FontSize="13" TextWrapping="Wrap" /></DockPanel>
                                    </UniformGrid>
                                </StackPanel>
                            </RadioButton>
                        </Border>

                        <Border x:Name="WillBanner" Padding="14,10" CornerRadius="6" BorderThickness="1" Margin="0,0,0,10">
                            <DockPanel>
                                <TextBlock x:Name="WillIcon" DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="&#xE70F;" FontSize="18" Margin="0,0,12,0" />
                                <TextBlock x:Name="WillText" FontSize="13" TextWrapping="Wrap" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" />
                            </DockPanel>
                        </Border>
                    </StackPanel>
                    <TextBlock x:Name="EstimateText" Style="{StaticResource Secondary}" Margin="0,0,0,4" />
                    <TextBlock Text="{l:L Gd.ShareNote}" Style="{StaticResource Secondary}" />
                </StackPanel>

                <!-- 4 Replace -->
                <StackPanel x:Name="ReplacePanel" Visibility="Collapsed">
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition x:Name="SecondCardColumn" Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="OriginalCard" Style="{StaticResource Card}" Margin="0,0,6,0" BorderBrush="{DynamicResource SystemFillColorSuccessBrush}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock x:Name="OriginalTagIcon" Style="{StaticResource Icon}" Text="&#xE72E;" Margin="0,0,8,0" Foreground="{DynamicResource SystemFillColorSuccessBrush}" />
                                    <TextBlock x:Name="OriginalTag" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SystemFillColorSuccessBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                                <TextBlock x:Name="OriginalName" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock x:Name="OriginalBody" Style="{StaticResource Secondary}" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>
                        <Border x:Name="CopyWriteCard" Grid.Column="1" Style="{StaticResource Card}" Margin="6,0,0,0" BorderThickness="2"
                                BorderBrush="{DynamicResource AccentFillColorDefaultBrush}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE70F;" Margin="0,0,8,0" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                    <TextBlock Text="{l:L Gd.TagCopy}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                                <TextBlock x:Name="CopyName" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <WrapPanel Margin="0,2,0,0">
                                    <TextBlock x:Name="CopyBody" Style="{StaticResource Secondary}" VerticalAlignment="Center" />
                                    <Button x:Name="OpenNowButton" Style="{StaticResource LinkButton}" Content="{l:L Gd.OpenNow}" Click="OpenCopy_Click" FontSize="12" Padding="6,0" MinHeight="20" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Style="{StaticResource Card}" Padding="18,16" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock x:Name="ReplaceTitle" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,12"
                                       AutomationProperties.LiveSetting="Polite" AutomationProperties.HeadingLevel="Level1" />
                            <DockPanel x:Name="PhaseCopy" Margin="0,0,0,12">
                                <TextBlock x:Name="PhaseCopyIcon" DockPanel.Dock="Left" Style="{StaticResource Icon}" FontSize="20" Margin="0,0,12,0" VerticalAlignment="Top" />
                                <StackPanel>
                                    <TextBlock x:Name="PhaseCopyText" FontSize="14" TextWrapping="Wrap" />
                                    <TextBlock x:Name="PhaseCopyDetail" Style="{StaticResource Secondary}" />
                                </StackPanel>
                            </DockPanel>
                            <DockPanel Margin="0,0,0,12">
                                <TextBlock x:Name="PhaseReplaceIcon" DockPanel.Dock="Left" Style="{StaticResource Icon}" FontSize="20" Margin="0,0,12,0" VerticalAlignment="Top" />
                                <StackPanel>
                                    <DockPanel>
                                        <TextBlock x:Name="ReplaceLeft" DockPanel.Dock="Right" Style="{StaticResource Secondary}" FontSize="13" />
                                        <TextBlock Text="{l:L Gd.PhReplace}" FontSize="14" FontWeight="SemiBold" />
                                    </DockPanel>
                                    <ProgressBar x:Name="ReplaceBar" Height="8" Minimum="0" Maximum="1" Margin="0,8,0,6"
                                                 AutomationProperties.LabeledBy="{Binding ElementName=ReplaceTitle}" />
                                    <TextBlock x:Name="GroupText" Style="{StaticResource Secondary}" />
                                </StackPanel>
                            </DockPanel>
                            <DockPanel Margin="0,0,0,12">
                                <TextBlock x:Name="PhaseCleanIcon" DockPanel.Dock="Left" Style="{StaticResource Icon}" FontSize="20" Margin="0,0,12,0" VerticalAlignment="Top" />
                                <TextBlock Text="{l:L Gd.PhClean}" FontSize="14" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </DockPanel>
                            <Border Padding="12,8" CornerRadius="6" Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                                <StackPanel x:Name="LogLines" />
                            </Border>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Padding="14,10">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="&#xE823;" FontSize="16" Margin="0,0,10,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="StopSafeText" FontSize="13" TextWrapping="Wrap" />
                        </DockPanel>
                    </Border>
                </StackPanel>

                <!-- 5 Done -->
                <StackPanel x:Name="DonePanel" Visibility="Collapsed">
                    <Border Style="{StaticResource Card}" Padding="24,22" Margin="0,0,0,14">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock x:Name="DoneIcon" Style="{StaticResource Icon}" Text="&#xE930;" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,8"
                                       Foreground="{DynamicResource SystemFillColorSuccessBrush}" />
                            <TextBlock x:Name="DoneTitle" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                                       AutomationProperties.LiveSetting="Assertive" AutomationProperties.HeadingLevel="Level1" />
                            <TextBlock x:Name="DoneSub" FontSize="14" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,4,0,8"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <StackPanel x:Name="DoneNumbers" Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock x:Name="DoneBefore" FontSize="26" TextDecorations="Strikethrough" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE72A;" FontSize="18" Margin="14,0" />
                                <TextBlock x:Name="DoneAfter" FontSize="32" FontWeight="Bold" VerticalAlignment="Center" Foreground="{DynamicResource SystemFillColorSuccessBrush}" />
                                <Border CornerRadius="12" Padding="10,2" Margin="14,0,0,0" VerticalAlignment="Center" Background="{DynamicResource SystemFillColorSuccessBackgroundBrush}">
                                    <TextBlock x:Name="DonePct" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource SystemFillColorSuccessBrush}" />
                                </Border>
                            </StackPanel>
                            <TextBlock x:Name="DoneChanged" FontSize="13" TextWrapping="Wrap" TextAlignment="Center" Margin="0,10,0,0" />
                            <TextBlock x:Name="DoneFailed" FontSize="13" TextWrapping="Wrap" TextAlignment="Center" Margin="0,4,0,0"
                                       Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Padding="0" Margin="0,0,0,14">
                        <StackPanel>
                            <DockPanel x:Name="RowCopy" Margin="16,12">
                                <Button DockPanel.Dock="Right" Content="{l:L Gd.CopyLink}" Click="CopyLink_Click" MinHeight="32" Padding="12,4" VerticalAlignment="Center" />
                                <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="&#xE8A5;" FontSize="20" Margin="0,0,14,0" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="RowCopyName" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="{l:L Gd.RowCopySub}" Style="{StaticResource Secondary}" />
                                </StackPanel>
                            </DockPanel>
                            <Border x:Name="RowCopyLine" Height="1" Background="{DynamicResource DividerStrokeColorDefaultBrush}" />
                            <DockPanel Margin="16,12">
                                <Button x:Name="RowOriginalButton" DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Click="OpenOriginal_Click" VerticalAlignment="Center" />
                                <TextBlock x:Name="RowOriginalIcon" DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="&#xE72E;" FontSize="20" Margin="0,0,14,0" Foreground="{DynamicResource SystemFillColorSuccessBrush}" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="RowOriginalName" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock x:Name="RowOriginalSub" Style="{StaticResource Secondary}" />
                                </StackPanel>
                            </DockPanel>
                            <Border x:Name="RowPcLine" Height="1" Background="{DynamicResource DividerStrokeColorDefaultBrush}" />
                            <DockPanel x:Name="RowPc" Margin="16,12">
                                <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="{l:L Gd.Show}" Click="Originals_Click" VerticalAlignment="Center" />
                                <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="&#xE8B7;" FontSize="20" Margin="0,0,14,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="RowPcTitle" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock x:Name="RowPcPath" Style="{StaticResource Secondary}" />
                                </StackPanel>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <Border Padding="14,10" CornerRadius="6" BorderThickness="1" Background="{DynamicResource SystemFillColorAttentionBackgroundBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="&#xE946;" FontSize="16" Margin="0,0,10,0" VerticalAlignment="Top"
                                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock x:Name="DoneNote" FontSize="13" TextWrapping="Wrap" />
                        </DockPanel>
                    </Border>
                </StackPanel>

                <!-- Problems, in plain words -->
                <Border x:Name="ErrorPanel" Visibility="Collapsed" Padding="14,10" CornerRadius="6" BorderThickness="1" Margin="0,14,0,0"
                        BorderBrush="{DynamicResource SystemFillColorCriticalBrush}" Background="{DynamicResource SystemFillColorCriticalBackgroundBrush}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="&#xE783;" Margin="0,0,10,0" VerticalAlignment="Top"
                                   Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
                        <TextBlock x:Name="ErrorText" TextWrapping="Wrap" FontSize="13" AutomationProperties.LiveSetting="Assertive" />
                    </DockPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Commands: the main action on the right, Close/Cancel/Stop last (Microsoft dialog order) -->
        <Border Grid.Row="1" Padding="28,12" BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" Background="{DynamicResource LayerFillColorDefaultBrush}">
            <DockPanel>
                <Button x:Name="LeftButton" DockPanel.Dock="Left" Click="Left_Click" MinHeight="32" Padding="12,4" Margin="0,0,12,0" Visibility="Collapsed" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="PrimaryButton" Click="Primary_Click" MinHeight="32" MinWidth="96" Padding="16,4" Margin="0,0,8,0"
                            Style="{DynamicResource AccentButtonStyle}" />
                    <Button x:Name="CloseButton" IsCancel="True" Click="Close_Click" MinHeight="32" MinWidth="96" Padding="12,4" />
                </StackPanel>
                <TextBlock x:Name="HintText" Style="{StaticResource Secondary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
