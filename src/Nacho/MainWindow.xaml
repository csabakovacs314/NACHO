<Window x:Class="Nacho.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:Nacho"
        Title="NACHO" Width="1240" Height="800" MinWidth="420" MinHeight="560"
        WindowStartupLocation="CenterScreen" AllowDrop="True"
        DragEnter="Window_DragEnter" DragOver="Window_DragOver" DragLeave="Window_DragLeave" Drop="Window_Drop"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="Vis" />
        <Style x:Key="Secondary" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="Icon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
    </Window.Resources>

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Command bar -->
        <WrapPanel Grid.Row="0" Margin="12,10,12,4" Orientation="Horizontal" KeyboardNavigation.TabNavigation="Local">
            <Button x:Name="AddButton" Click="Add_Click" Margin="4" Padding="14,5" MinHeight="32"
                    Style="{DynamicResource AccentButtonStyle}" ToolTip="Ctrl+O"
                    AutomationProperties.Name="{l:L Cmd.Add}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" />
                    <TextBlock Text="{l:L Cmd.Add}" />
                </StackPanel>
            </Button>
            <Button Click="Paste_Click" Margin="4" Padding="12,5" MinHeight="32" ToolTip="Ctrl+V"
                    AutomationProperties.Name="{l:L Cmd.Paste}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE77F;" />
                    <TextBlock Text="{l:L Cmd.Paste}" />
                </StackPanel>
            </Button>
            <Border Width="1" Height="24" Margin="8,0" VerticalAlignment="Center" Background="{DynamicResource DividerStrokeColorDefaultBrush}" />
            <TextBlock Text="{l:L Cmd.Preset}" Style="{StaticResource Secondary}" VerticalAlignment="Center" Margin="4,0,6,0" />
            <StackPanel x:Name="PresetGroup" Orientation="Horizontal" Margin="0,4,4,4" AutomationProperties.Name="{l:L Cmd.Preset}">
                <RadioButton x:Name="PresetSmall" Tag="small" GroupName="Preset" Checked="Preset_Checked"
                             Style="{DynamicResource {x:Type ToggleButton}}" MinHeight="32" Padding="12,4" Margin="0,0,2,0" />
                <RadioButton x:Name="PresetBalanced" Tag="balanced" GroupName="Preset" Checked="Preset_Checked"
                             Style="{DynamicResource {x:Type ToggleButton}}" MinHeight="32" Padding="12,4" Margin="0,0,2,0" />
                <RadioButton x:Name="PresetSharp" Tag="sharp" GroupName="Preset" Checked="Preset_Checked"
                             Style="{DynamicResource {x:Type ToggleButton}}" MinHeight="32" Padding="12,4" />
            </StackPanel>
            <Button Click="Options_Click" Margin="4" Padding="12,5" MinHeight="32" ToolTip="Ctrl+,"
                    AutomationProperties.Name="{l:L Cmd.Options}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE713;" />
                    <TextBlock Text="{l:L Cmd.Options}" />
                </StackPanel>
            </Button>
            <Button Click="Undo_Click" Margin="4" Padding="12,5" MinHeight="32" ToolTip="Ctrl+Z"
                    AutomationProperties.Name="{l:L Cmd.Undo}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE7A7;" />
                    <TextBlock Text="{l:L Cmd.Undo}" />
                </StackPanel>
            </Button>
            <Button Click="Help_Click" Margin="4" Padding="10,5" MinHeight="32" MinWidth="32" ToolTip="F1"
                    AutomationProperties.Name="{l:L Cmd.Help}">
                <TextBlock Style="{StaticResource Icon}" Margin="0" Text="&#xE897;" />
            </Button>
            <StackPanel Orientation="Horizontal" Margin="4" AutomationProperties.Name="{l:L Cmd.Language}" ToolTip="{l:L Cmd.Language}">
                <TextBlock Style="{StaticResource Icon}" Text="&#xE774;" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <RadioButton x:Name="LangEn" Tag="en" GroupName="Lang" Content="EN" Checked="Language_Checked"
                             AutomationProperties.Name="English" Style="{DynamicResource {x:Type ToggleButton}}"
                             MinHeight="32" MinWidth="44" Padding="10,4" Margin="0,0,2,0" />
                <RadioButton x:Name="LangEs" Tag="es" GroupName="Lang" Content="ES" Checked="Language_Checked"
                             AutomationProperties.Name="Español" Style="{DynamicResource {x:Type ToggleButton}}"
                             MinHeight="32" MinWidth="44" Padding="10,4" />
            </StackPanel>
        </WrapPanel>

        <!-- Content -->
        <Grid x:Name="ContentGrid" Grid.Row="1" Margin="16,4,16,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid x:Name="LeftPane">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid x:Name="DropZone" Margin="0,0,0,12" MinHeight="64">
                    <Rectangle x:Name="DropRect" RadiusX="8" RadiusY="8" StrokeThickness="2" StrokeDashArray="4 3"
                               Stroke="{DynamicResource ControlStrongStrokeColorDefaultBrush}"
                               Fill="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
                    <DockPanel Margin="16,10">
                        <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Margin="0,0,14,0" FontSize="24" Text="&#xE896;"
                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="DropTitle" Text="{l:L Drop.Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock x:Name="DropRelease" Text="{l:L Drop.Release}" FontWeight="SemiBold" TextWrapping="Wrap" Visibility="Collapsed" />
                            <TextBlock Text="{l:L Drop.Sub}" Style="{StaticResource Secondary}" FontSize="13" TextWrapping="Wrap" />
                        </StackPanel>
                    </DockPanel>
                </Grid>

                <DockPanel Grid.Row="1" Margin="0,0,0,8">
                    <ToggleButton x:Name="PreviewToggle" DockPanel.Dock="Right" Content="{l:L Preview.Title}" Visibility="Collapsed"
                                  Checked="PreviewToggle_Changed" Unchecked="PreviewToggle_Changed" MinHeight="32" Padding="10,4" />
                    <TextBlock FontWeight="SemiBold" VerticalAlignment="Center">
                        <Run Text="{l:L List.Header}" /><Run x:Name="CountRun" Text="" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontWeight="Normal" />
                    </TextBlock>
                </DockPanel>

                <Grid Grid.Row="2">
                    <ListBox x:Name="Results" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionMode="Single"
                             VirtualizingPanel.ScrollUnit="Pixel"
                             SelectionChanged="Results_SelectionChanged" KeyDown="Results_KeyDown"
                             AutomationProperties.Name="{l:L List.Header}">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type l:ResultItem}">
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="{l:L Tile.CopyFile}" InputGestureText="Ctrl+Shift+C" Click="CtxCopyFile_Click"
                                                      Visibility="{Binding CanDeliver, Converter={StaticResource Vis}}" />
                                            <MenuItem Header="{l:L Tile.CopyPicture}" Click="CtxCopyPicture_Click"
                                                      Visibility="{Binding CanDeliver, Converter={StaticResource Vis}}" />
                                            <MenuItem Header="{l:L Tile.ShowFolder}" Click="CtxShowFolder_Click"
                                                      Visibility="{Binding CanDeliver, Converter={StaticResource Vis}}" />
                                            <MenuItem Header="{l:L Tile.OpenOriginal}" Click="CtxOpenOriginal_Click" />
                                            <Separator />
                                            <MenuItem Header="{l:L Tile.Remove}" InputGestureText="Delete" Click="CtxRemove_Click" />
                                        </ContextMenu>
                                    </Grid.ContextMenu>

                                    <StackPanel Grid.Column="0" Grid.RowSpan="2" Margin="0,0,12,0" VerticalAlignment="Center">
                                        <Border Width="96" Height="72" CornerRadius="6" BorderThickness="1" ClipToBounds="True" Cursor="Hand"
                                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                                Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                                ToolTip="{l:L Tile.DragHint}" AutomationProperties.Name="{Binding DragName}"
                                                PreviewMouseLeftButtonDown="Thumb_MouseDown" MouseMove="Thumb_MouseMove">
                                            <Grid>
                                                <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                                                <ProgressBar IsIndeterminate="True" Width="60" VerticalAlignment="Center"
                                                             Visibility="{Binding IsWorking, Converter={StaticResource Vis}}" />
                                                <TextBlock Style="{StaticResource Icon}" Margin="0" FontSize="28" Text="&#xE783;"
                                                           HorizontalAlignment="Center" Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                                           Visibility="{Binding IsError, Converter={StaticResource Vis}}" />
                                            </Grid>
                                        </Border>
                                        <TextBlock Text="{l:L Tile.DragHint}" FontSize="12" Style="{StaticResource Secondary}"
                                                   HorizontalAlignment="Center" Margin="0,4,0,0"
                                                   Visibility="{Binding CanDeliver, Converter={StaticResource Vis}}" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{l:L Tile.Working}" Style="{StaticResource Secondary}"
                                                   Visibility="{Binding IsWorking, Converter={StaticResource Vis}}" />
                                        <StackPanel Visibility="{Binding IsOk, Converter={StaticResource Vis}}">
                                            <TextBlock TextWrapping="Wrap">
                                                <Run Text="{Binding SizeText, Mode=OneWay}" /><Run Text=" · " /><Run
                                                     Text="{Binding SmallerText, Mode=OneWay}" FontWeight="SemiBold"
                                                     Foreground="{DynamicResource SystemFillColorSuccessBrush}" />
                                            </TextBlock>
                                            <TextBlock Text="{Binding PxText}" FontSize="12" Style="{StaticResource Secondary}" TextWrapping="Wrap" />
                                            <ItemsControl ItemsSource="{Binding Badges}" Margin="0,4,0,0" Focusable="False">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border CornerRadius="10" Padding="8,1" Margin="0,0,6,4" BorderThickness="1"
                                                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                                                Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                                                            <TextBlock Text="{Binding}" FontSize="12" />
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                        <StackPanel Visibility="{Binding IsKept, Converter={StaticResource Vis}}">
                                            <TextBlock Text="{l:L Tile.KeptTitle}" FontWeight="SemiBold" FontSize="13" />
                                            <TextBlock Text="{Binding KeptBody}" TextWrapping="Wrap" FontSize="13" />
                                        </StackPanel>
                                        <StackPanel Visibility="{Binding IsError, Converter={StaticResource Vis}}">
                                            <TextBlock Text="{l:L Err.Title}" FontWeight="SemiBold" FontSize="13"
                                                       Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
                                            <TextBlock Text="{Binding ErrorBody}" TextWrapping="Wrap" FontSize="13" />
                                        </StackPanel>
                                    </StackPanel>

                                    <StackPanel VerticalAlignment="Center">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Grid.Row" Value="0" />
                                                <Setter Property="Grid.Column" Value="2" />
                                                <Setter Property="Orientation" Value="Vertical" />
                                                <Setter Property="Width" Value="176" />
                                                <Setter Property="Margin" Value="12,0,0,0" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsNarrow, RelativeSource={RelativeSource AncestorType=l:MainWindow}}" Value="True">
                                                        <Setter Property="Grid.Row" Value="1" />
                                                        <Setter Property="Grid.Column" Value="1" />
                                                        <Setter Property="Orientation" Value="Horizontal" />
                                                        <Setter Property="Width" Value="NaN" />
                                                        <Setter Property="Margin" Value="0,8,0,0" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <Button Content="{l:L Tile.CopyFile}" Click="CopyFile_Click" MinHeight="32" Margin="0,0,6,6"
                                                Padding="10,4" ToolTip="Ctrl+Shift+C"
                                                Visibility="{Binding CanDeliver, Converter={StaticResource Vis}}" />
                                        <Button Content="{l:L Tile.ShowFolder}" Click="ShowFolder_Click" MinHeight="32" Margin="0,0,6,6"
                                                Padding="10,4"
                                                Visibility="{Binding CanDeliver, Converter={StaticResource Vis}}" />
                                        <Button Content="{l:L Tile.Remove}" Click="Remove_Click" MinHeight="32" Margin="0,0,6,6"
                                                Padding="10,4"
                                                Visibility="{Binding IsError, Converter={StaticResource Vis}}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="440" Margin="16">
                        <TextBlock Text="{l:L Empty.Title}" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        <TextBlock Text="{l:L Empty.Body}" Style="{StaticResource Secondary}" TextWrapping="Wrap"
                                   TextAlignment="Center" Margin="0,6,0,0" />
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- Page-fit preview -->
            <Border x:Name="PreviewPanel" Grid.Column="1" Width="380" Margin="16,0,0,0" Padding="16" CornerRadius="8" BorderThickness="1"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,12">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" AutomationProperties.Name="{l:L Preview.PageSize}">
                                <RadioButton x:Name="PageA4" Tag="A4" GroupName="Page" Content="{l:L Page.A4}" Checked="Page_Checked"
                                             Style="{DynamicResource {x:Type ToggleButton}}" MinWidth="60" MinHeight="28" Padding="10,2" Margin="0,0,2,0" />
                                <RadioButton x:Name="PageLetter" Tag="Letter" GroupName="Page" Content="{l:L Page.Letter}" Checked="Page_Checked"
                                             Style="{DynamicResource {x:Type ToggleButton}}" MinWidth="60" MinHeight="28" Padding="10,2" />
                            </StackPanel>
                            <TextBlock Text="{l:L Preview.Title}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" />
                        </DockPanel>

                        <StackPanel x:Name="PreviewOk" Visibility="Collapsed">
                            <Border Padding="16" CornerRadius="6" Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                                <Border x:Name="PageSheet" Width="200" Height="283" Padding="24" Background="White"
                                        BorderBrush="#C8C8C8" BorderThickness="1" HorizontalAlignment="Center">
                                    <StackPanel>
                                        <Rectangle Height="7" Width="105" Fill="#8A8A8A" HorizontalAlignment="Left" Margin="0,0,0,5" />
                                        <Rectangle Height="5" Width="150" Fill="#D6D6D6" HorizontalAlignment="Left" Margin="0,0,0,5" />
                                        <Rectangle Height="5" Width="138" Fill="#D6D6D6" HorizontalAlignment="Left" Margin="0,0,0,5" />
                                        <Image x:Name="PageImage" HorizontalAlignment="Left" Stretch="Fill" Margin="0,0,0,5" />
                                        <Rectangle Height="5" Width="150" Fill="#D6D6D6" HorizontalAlignment="Left" Margin="0,0,0,5" />
                                        <Rectangle Height="5" Width="144" Fill="#D6D6D6" HorizontalAlignment="Left" Margin="0,0,0,5" />
                                        <Rectangle Height="5" Width="150" Fill="#D6D6D6" HorizontalAlignment="Left" Margin="0,0,0,5" />
                                        <Rectangle Height="5" Width="81" Fill="#D6D6D6" HorizontalAlignment="Left" />
                                    </StackPanel>
                                </Border>
                            </Border>
                            <TextBlock x:Name="PreviewCaption" TextWrapping="Wrap" Margin="0,12,0,0" FontSize="13" LineHeight="19" />
                            <TextBlock Text="{l:L Preview.TableCaption}" FontWeight="SemiBold" FontSize="13" Margin="0,14,0,6" />
                            <Grid x:Name="Compare">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="{l:L Preview.ColDetail}" Style="{StaticResource Secondary}" FontSize="13" FontWeight="SemiBold" Margin="0,0,12,6" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{l:L Preview.ColOriginal}" Style="{StaticResource Secondary}" FontSize="13" FontWeight="SemiBold" Margin="0,0,8,6" />
                                <TextBlock Grid.Row="0" Grid.Column="2" Text="{l:L Preview.ColCopy}" Style="{StaticResource Secondary}" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6" />
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="{l:L Preview.RowSize}" FontSize="13" Margin="0,0,12,6" />
                                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="CmpSizeA" FontSize="13" Margin="0,0,8,6" />
                                <TextBlock Grid.Row="1" Grid.Column="2" x:Name="CmpSizeB" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6" />
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="{l:L Preview.RowPixels}" FontSize="13" Margin="0,0,12,6" />
                                <TextBlock Grid.Row="2" Grid.Column="1" x:Name="CmpPxA" FontSize="13" Margin="0,0,8,6" />
                                <TextBlock Grid.Row="2" Grid.Column="2" x:Name="CmpPxB" FontSize="13" Margin="0,0,0,6" />
                                <TextBlock Grid.Row="3" Grid.Column="0" Text="{l:L Preview.RowFormat}" FontSize="13" Margin="0,0,12,6" />
                                <TextBlock Grid.Row="3" Grid.Column="1" x:Name="CmpFmtA" FontSize="13" Margin="0,0,8,6" />
                                <TextBlock Grid.Row="3" Grid.Column="2" x:Name="CmpFmtB" FontSize="13" Margin="0,0,0,6" />
                                <TextBlock Grid.Row="4" Grid.Column="0" Text="{l:L Preview.RowLocation}" FontSize="13" Margin="0,0,12,0" TextWrapping="Wrap" MaxWidth="120" />
                                <TextBlock Grid.Row="4" Grid.Column="1" x:Name="CmpLocA" FontSize="13" Margin="0,0,8,0" />
                                <TextBlock Grid.Row="4" Grid.Column="2" x:Name="CmpLocB" FontSize="13" />
                            </Grid>
                            <TextBlock Text="{l:L Preview.Untouched}" Style="{StaticResource Secondary}" FontSize="12" TextWrapping="Wrap" Margin="0,12,0,0" />
                        </StackPanel>

                        <Border x:Name="PreviewKept" Visibility="Collapsed" Padding="16" CornerRadius="6"
                                Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                            <StackPanel>
                                <TextBlock Text="{l:L Preview.KeptTitle}" FontWeight="SemiBold" />
                                <TextBlock x:Name="PreviewKeptBody" TextWrapping="Wrap" FontSize="13" Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>

                        <Border x:Name="PreviewError" Visibility="Collapsed" Padding="16" CornerRadius="6"
                                Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                            <StackPanel>
                                <TextBlock Text="{l:L Err.Title}" FontWeight="SemiBold" Foreground="{DynamicResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" />
                                <TextBlock x:Name="PreviewErrorBody" TextWrapping="Wrap" FontSize="13" Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>

                        <TextBlock x:Name="PreviewEmpty" Style="{StaticResource Secondary}" TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Status bar -->
        <Border Grid.Row="2" BorderThickness="0,1,0,0" Padding="16,8"
                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                Background="{DynamicResource LayerFillColorDefaultBrush}">
            <DockPanel>
                <TextBlock x:Name="SavingsText" DockPanel.Dock="Right" Style="{StaticResource Secondary}" FontSize="13"
                           Margin="16,0,0,0" VerticalAlignment="Center" />
                <TextBlock x:Name="StatusText" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           AutomationProperties.LiveSetting="Polite" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
