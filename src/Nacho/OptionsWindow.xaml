<Window x:Class="Nacho.OptionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:Nacho"
        Title="{l:L Opt.Title}" Width="660" Height="800" MinWidth="440" MinHeight="420"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Window.Resources>
        <Style x:Key="Secondary" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Padding" Value="16" />
            <Setter Property="Margin" Value="0,0,0,16" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
        </Style>
        <Style x:Key="Heading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
    </Window.Resources>

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="24,16,24,8">
                <TextBlock Text="{l:L Opt.Title}" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,16" />

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="{l:L Opt.Presets}" Style="{StaticResource Heading}" />
                        <TextBlock Text="{l:L Opt.PresetsHint}" Style="{StaticResource Secondary}" Margin="0,0,0,12" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Column="0" Text="{l:L Opt.ColDefault}" Style="{StaticResource Secondary}" FontWeight="SemiBold" Margin="0,0,16,8" />
                            <TextBlock Grid.Column="1" Text="{l:L Opt.ColPreset}" Style="{StaticResource Secondary}" FontWeight="SemiBold" Margin="0,0,16,8" />
                            <TextBlock Grid.Column="2" Text="{l:L Opt.ColEdge}" Style="{StaticResource Secondary}" FontWeight="SemiBold" Margin="0,0,12,8" />
                            <TextBlock Grid.Column="3" Text="{l:L Opt.ColBudget}" Style="{StaticResource Secondary}" FontWeight="SemiBold" Margin="0,0,0,8" />

                            <RadioButton x:Name="DefSmall" Grid.Row="1" GroupName="Default" VerticalAlignment="Center" Margin="0,0,16,8" />
                            <TextBlock x:Name="NameSmall" Grid.Row="1" Grid.Column="1" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,16,8" />
                            <TextBox x:Name="EdgeSmall" Grid.Row="1" Grid.Column="2" MaxWidth="130" HorizontalAlignment="Left" MinWidth="100" Margin="0,0,12,8" />
                            <TextBox x:Name="BudgetSmall" Grid.Row="1" Grid.Column="3" MaxWidth="130" HorizontalAlignment="Left" MinWidth="100" Margin="0,0,0,8" />

                            <RadioButton x:Name="DefBalanced" Grid.Row="2" GroupName="Default" VerticalAlignment="Center" Margin="0,0,16,8" />
                            <TextBlock x:Name="NameBalanced" Grid.Row="2" Grid.Column="1" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,16,8" />
                            <TextBox x:Name="EdgeBalanced" Grid.Row="2" Grid.Column="2" MaxWidth="130" HorizontalAlignment="Left" MinWidth="100" Margin="0,0,12,8" />
                            <TextBox x:Name="BudgetBalanced" Grid.Row="2" Grid.Column="3" MaxWidth="130" HorizontalAlignment="Left" MinWidth="100" Margin="0,0,0,8" />

                            <RadioButton x:Name="DefSharp" Grid.Row="3" GroupName="Default" VerticalAlignment="Center" Margin="0,0,16,0" />
                            <TextBlock x:Name="NameSharp" Grid.Row="3" Grid.Column="1" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,16,0" />
                            <TextBox x:Name="EdgeSharp" Grid.Row="3" Grid.Column="2" MaxWidth="130" HorizontalAlignment="Left" MinWidth="100" Margin="0,0,12,0" />
                            <TextBox x:Name="BudgetSharp" Grid.Row="3" Grid.Column="3" MaxWidth="130" HorizontalAlignment="Left" MinWidth="100" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel AutomationProperties.Name="{l:L Opt.Format}">
                        <TextBlock Text="{l:L Opt.Format}" Style="{StaticResource Heading}" />
                        <RadioButton x:Name="FmtAuto" GroupName="Format" Content="{l:L Opt.FormatAuto}" Margin="0,0,0,8" />
                        <RadioButton x:Name="FmtJpeg" GroupName="Format" Content="{l:L Opt.FormatJpeg}" Margin="0,0,0,8" />
                        <RadioButton x:Name="FmtPng" GroupName="Format" Content="{l:L Opt.FormatPng}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="{l:L Opt.Privacy}" Style="{StaticResource Heading}" />
                        <CheckBox x:Name="PrivLocation" Content="{l:L Opt.PrivacyLocation}" Margin="0,0,0,8" />
                        <CheckBox x:Name="PrivCamera" Content="{l:L Opt.PrivacyCamera}" Margin="0,0,0,8" />
                        <TextBlock Text="{l:L Opt.PrivacyHint}" Style="{StaticResource Secondary}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="{l:L Opt.Where}" Style="{StaticResource Heading}" />
                        <Label Content="{l:L Opt.Folder}" Target="{Binding ElementName=FolderBox}" Padding="0" Margin="0,0,0,6" />
                        <DockPanel Margin="0,0,0,12">
                            <Button DockPanel.Dock="Right" Content="{l:L Opt.ChangeFolder}" Click="ChangeFolder_Click" MinHeight="32" Padding="12,4" Margin="8,0,0,0" />
                            <TextBox x:Name="FolderBox" IsReadOnly="True" VerticalContentAlignment="Center" />
                        </DockPanel>
                        <Label Content="{l:L Opt.Suffix}" Target="{Binding ElementName=SuffixBox}" Padding="0" Margin="0,0,0,6" />
                        <TextBox x:Name="SuffixBox" Width="180" HorizontalAlignment="Left" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="{l:L Opt.Shell}" Style="{StaticResource Heading}" />
                        <CheckBox x:Name="CtxMenu" Content="{l:L Opt.ContextMenu}" />
                        <TextBlock Text="{l:L Opt.ContextMenuHint}" Style="{StaticResource Secondary}" Margin="28,2,0,10" />
                        <CheckBox x:Name="SendToBox" Content="{l:L Opt.SendTo}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="{l:L Opt.Updates}" Style="{StaticResource Heading}" />
                        <CheckBox x:Name="UpdatesBox" Content="{l:L Opt.CheckUpdates}" />
                        <TextBlock Text="{l:L Opt.CheckUpdatesHint}" Style="{StaticResource Secondary}" Margin="28,2,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Label Content="{l:L Opt.Language}" Target="{Binding ElementName=LangBox}" Padding="0" Margin="0,0,0,6" FontSize="16" FontWeight="SemiBold" />
                        <ComboBox x:Name="LangBox" Width="180" HorizontalAlignment="Left">
                            <ComboBoxItem Tag="en" Content="English" />
                            <ComboBoxItem Tag="es" Content="Español" />
                            <ComboBoxItem Tag="hu" Content="Magyar" />
                        </ComboBox>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1" Padding="24,12" BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                Background="{DynamicResource LayerFillColorDefaultBrush}">
            <StackPanel>
                <TextBlock x:Name="ErrorText" Visibility="Collapsed" TextWrapping="Wrap" Margin="0,0,0,10"
                           Foreground="{DynamicResource SystemFillColorCriticalBrush}" AutomationProperties.LiveSetting="Assertive" />
                <DockPanel>
                    <Button DockPanel.Dock="Left" Content="{l:L Opt.Reset}" Click="Reset_Click" MinHeight="32" Padding="12,4" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="{l:L Opt.Cancel}" IsCancel="True" MinHeight="32" MinWidth="96" Padding="12,4" Margin="0,0,8,0" />
                        <Button Content="{l:L Opt.Save}" IsDefault="True" Click="Save_Click" MinHeight="32" MinWidth="96" Padding="12,4"
                                Style="{DynamicResource AccentButtonStyle}" />
                    </StackPanel>
                </DockPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
