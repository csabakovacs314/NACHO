<Window x:Class="Nacho.WordDocWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:Nacho"
        Title="{l:L Wd.Title}" Width="720" Height="860" MinWidth="480" MinHeight="520"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="True" AllowDrop="True"
        DragEnter="Window_DragOver" DragOver="Window_DragOver" Drop="Window_Drop">
    <Window.TaskbarItemInfo>
        <TaskbarItemInfo x:Name="Taskbar" />
    </Window.TaskbarItemInfo>
    <Window.Resources>
        <FontFamily x:Key="Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
        <Style x:Key="Secondary" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Padding" Value="16,14" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
        </Style>
        <Style x:Key="Chip" TargetType="Border">
            <Setter Property="Padding" Value="10,3" />
            <Setter Property="Margin" Value="0,0,8,6" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
        </Style>
        <Style x:Key="Icon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Icons}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="IconTile" TargetType="Border">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="44" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="LinkButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Window.Resources>

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer x:Name="Scroller" Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="28,18,28,12">

                <!-- H1: five steps, the same as for a Google Doc -->
                <Grid x:Name="StepsGrid" Margin="0,0,0,16" AutomationProperties.Name="{l:L Gd.Steps}" />

                <!-- Nothing can change yet -->
                <Border x:Name="SafeBar" Padding="14,10" CornerRadius="6" BorderThickness="1" Margin="0,0,0,14"
                        Background="{DynamicResource SystemFillColorSuccessBackgroundBrush}" BorderBrush="{DynamicResource SystemFillColorSuccessBrush}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="&#xEA18;" FontSize="18" Margin="0,0,12,0"
                                   Foreground="{DynamicResource SystemFillColorSuccessBrush}" />
                        <Border DockPanel.Dock="Right" CornerRadius="10" BorderThickness="1" Padding="10,2" Margin="12,0,0,0" VerticalAlignment="Center"
                                BorderBrush="{DynamicResource SystemFillColorSuccessBrush}" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                            <TextBlock x:Name="SafeTag" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SystemFillColorSuccessBrush}" />
                        </Border>
                        <TextBlock x:Name="SafeText" FontSize="13" TextWrapping="Wrap" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" />
                    </DockPanel>
                </Border>

                <!-- 1 Choose: two places, equal weight -->
                <StackPanel x:Name="ChoosePanel">
                    <TextBlock Text="{l:L Wd.Where}" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12" AutomationProperties.HeadingLevel="Level1" />
                    <UniformGrid x:Name="SourceGrid" Columns="2" Margin="0,0,0,4">
                        <Border x:Name="PcCard" Style="{StaticResource Card}" Padding="18" Margin="0,0,6,10">
                            <DockPanel>
                                <Button x:Name="PcButton" DockPanel.Dock="Bottom" Content="{l:L Wd.PcButton}" Click="Pc_Click" HorizontalAlignment="Stretch"
                                        MinHeight="40" Padding="16,6" FontSize="14" FontWeight="SemiBold" Margin="0,12,0,0" Style="{DynamicResource AccentButtonStyle}"
                                        AutomationProperties.HelpText="{l:L Wd.PcSub}" />
                                <StackPanel>
                                    <Border Style="{StaticResource IconTile}">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE7F4;" FontSize="22" HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                    </Border>
                                    <TextBlock x:Name="PcTitle" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,6" AutomationProperties.HeadingLevel="Level2" />
                                    <TextBlock Text="{l:L Wd.PcSub}" FontSize="13" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <Border x:Name="DriveCard" Style="{StaticResource Card}" Padding="18" Margin="6,0,0,10">
                            <DockPanel>
                                <Button x:Name="DriveButton" DockPanel.Dock="Bottom" Content="{l:L Wd.DriveButton}" Click="Drive_Click" HorizontalAlignment="Stretch"
                                        MinHeight="40" Padding="16,6" FontSize="14" FontWeight="SemiBold" Margin="0,12,0,0" BorderThickness="2"
                                        BorderBrush="{DynamicResource AccentFillColorDefaultBrush}" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                        AutomationProperties.HelpText="{l:L Wd.DriveSub}" />
                                <StackPanel>
                                    <Border Style="{StaticResource IconTile}">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE753;" FontSize="22" HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                    </Border>
                                    <TextBlock Text="{l:L Wd.DriveTitle}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,6" AutomationProperties.HeadingLevel="Level2" />
                                    <TextBlock Text="{l:L Wd.DriveSub}" FontSize="13" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <WrapPanel Margin="0,8,0,0">
                                        <TextBlock x:Name="AccountText" Style="{StaticResource Secondary}" VerticalAlignment="Center" Margin="0,0,6,0"
                                                   AutomationProperties.LiveSetting="Polite" />
                                        <Button x:Name="OtherAccountButton" Style="{StaticResource LinkButton}" Content="{l:L Gd.OtherAccount}" Click="OtherAccount_Click"
                                                FontSize="12" Padding="2,0" MinHeight="24" />
                                    </WrapPanel>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </UniformGrid>

                    <StackPanel x:Name="RecentPanel" Margin="0,8,0,0">
                        <TextBlock Text="{l:L Gd.Recent}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8" AutomationProperties.HeadingLevel="Level2" />
                        <StackPanel x:Name="RecentList" />
                    </StackPanel>

                    <WrapPanel Margin="0,14,0,0">
                        <Border Style="{StaticResource Chip}"><TextBlock x:Name="PresetChip" FontSize="12" /></Border>
                        <Border Style="{StaticResource Chip}"><TextBlock x:Name="OriginalsChip" FontSize="12" /></Border>
                        <Button Style="{StaticResource LinkButton}" Content="{l:L Gd.Change}" Click="Change_Click" FontSize="12" Margin="0,0,0,6" />
                    </WrapPanel>
                </StackPanel>

                <!-- The file being worked on (steps 2 and 3) -->
                <Border x:Name="FileCard" Style="{StaticResource Card}" Margin="0,0,0,14" Visibility="Collapsed">
                    <DockPanel>
                        <Button x:Name="FileButton" DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Click="FileButton_Click" VerticalAlignment="Center" />
                        <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="&#xE8A5;" FontSize="24" Margin="0,0,14,0"
                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                        <StackPanel>
                            <TextBlock x:Name="FileName" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock x:Name="FileInfo" Style="{StaticResource Secondary}" Margin="0,2,0,0" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- 2 Check -->
                <StackPanel x:Name="CheckPanel" Visibility="Collapsed">
                    <Border Style="{StaticResource Card}" Padding="18,16" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock x:Name="CheckTitle" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,10"
                                       AutomationProperties.LiveSetting="Polite" AutomationProperties.HeadingLevel="Level1" />
                            <ProgressBar x:Name="CheckBar" Height="8" Minimum="0" Maximum="1" AutomationProperties.LabeledBy="{Binding ElementName=CheckTitle}" />
                        </StackPanel>
                    </Border>
                    <TextBlock Text="{l:L Gd.KeepUsing}" Style="{StaticResource Secondary}" />
                </StackPanel>

                <!-- 3 Decide -->
                <StackPanel x:Name="DecidePanel" Visibility="Collapsed">
                    <Border Style="{StaticResource Card}" Padding="18,14" Margin="0,0,0,14">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,10">
                                <TextBlock x:Name="CheckedAt" DockPanel.Dock="Right" Style="{StaticResource Secondary}" VerticalAlignment="Bottom" Margin="10,0,0,0" />
                                <TextBlock x:Name="ResultTitle" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" AutomationProperties.HeadingLevel="Level1" />
                            </DockPanel>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" MinWidth="64" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" MinWidth="80" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="{l:L Gd.BarNow}" Style="{StaticResource Secondary}" FontSize="13" VerticalAlignment="Center" Margin="0,0,10,6" />
                                <Border Grid.Column="1" Height="14" CornerRadius="3" Margin="0,0,10,6" Background="{DynamicResource ControlStrongStrokeColorDefaultBrush}" />
                                <TextBlock x:Name="BeforeText" Grid.Column="2" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Right" Margin="0,0,0,6" />
                                <TextBlock Grid.Row="1" Text="{l:L Gd.BarAfter}" Style="{StaticResource Secondary}" FontSize="13" VerticalAlignment="Center" Margin="0,0,10,0" />
                                <Grid x:Name="AfterBar" Grid.Row="1" Grid.Column="1" Margin="0,0,10,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="5*" />
                                        <ColumnDefinition Width="95*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Height="14" CornerRadius="3" MinWidth="6" Background="{DynamicResource SystemFillColorSuccessBrush}" />
                                </Grid>
                                <TextBlock x:Name="AfterText" Grid.Row="1" Grid.Column="2" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Right"
                                           Foreground="{DynamicResource SystemFillColorSuccessBrush}" />
                            </Grid>
                            <WrapPanel x:Name="CountChips" />
                        </StackPanel>
                    </Border>

                    <TextBlock x:Name="NothingText" Text="{l:L Wd.Nothing}" Visibility="Collapsed" TextWrapping="Wrap" FontSize="14" Margin="0,0,0,12" />

                    <StackPanel x:Name="WherePanel">
                        <TextBlock Text="{l:L Gd.WhereQ}" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8" AutomationProperties.HeadingLevel="Level2" />
                        <Border x:Name="CopyCard" CornerRadius="8" Margin="0,0,0,10" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                            <RadioButton x:Name="CopyRadio" GroupName="Dest" Checked="Dest_Checked" Padding="8,0,0,0" Margin="16,12"
                                         HorizontalContentAlignment="Stretch" AutomationProperties.HelpText="{l:L Gd.CopyPro1}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Text="{l:L Gd.IntoCopy}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        <Border CornerRadius="10" Padding="8,1" Margin="10,0,0,0" VerticalAlignment="Center" Background="{DynamicResource AccentFillColorDefaultBrush}">
                                            <TextBlock Text="{l:L Gd.Recommended}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock x:Name="CopySub" Style="{StaticResource Secondary}" FontSize="13" Margin="0,0,0,8" />
                                    <UniformGrid x:Name="CopyPoints" Columns="2" />
                                </StackPanel>
                            </RadioButton>
                        </Border>
                        <Border x:Name="FileChoiceCard" CornerRadius="8" Margin="0,0,0,12" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                            <RadioButton x:Name="FileRadio" GroupName="Dest" Checked="Dest_Checked" Padding="8,0,0,0" Margin="16,12"
                                         HorizontalContentAlignment="Stretch" AutomationProperties.HelpText="{l:L Wd.IntoFileSub}">
                                <StackPanel>
                                    <TextBlock Text="{l:L Wd.IntoFile}" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,4" />
                                    <TextBlock Text="{l:L Wd.IntoFileSub}" Style="{StaticResource Secondary}" FontSize="13" Margin="0,0,0,8" />
                                    <UniformGrid x:Name="FilePoints" Columns="2" />
                                </StackPanel>
                            </RadioButton>
                        </Border>

                        <Border x:Name="WillBanner" Padding="14,10" CornerRadius="6" BorderThickness="1" Margin="0,0,0,10">
                            <DockPanel>
                                <TextBlock x:Name="WillIcon" DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="&#xE70F;" FontSize="18" Margin="0,0,12,0" />
                                <TextBlock x:Name="WillText" FontSize="13" TextWrapping="Wrap" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" />
                            </DockPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>

                <!-- 4 Replace: one short write; the original stays whole until the new file is complete -->
                <StackPanel x:Name="ApplyPanel" Visibility="Collapsed">
                    <Border Style="{StaticResource Card}" Padding="18,16" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock x:Name="ApplyTitle" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,10"
                                       AutomationProperties.LiveSetting="Polite" AutomationProperties.HeadingLevel="Level1" />
                            <ProgressBar x:Name="ApplyBar" Height="8" IsIndeterminate="True" AutomationProperties.LabeledBy="{Binding ElementName=ApplyTitle}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Padding="14,10">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="&#xE72E;" FontSize="16" Margin="0,0,10,0" Foreground="{DynamicResource SystemFillColorSuccessBrush}" />
                            <TextBlock Text="{l:L Wd.HintWrite}" FontSize="13" TextWrapping="Wrap" />
                        </DockPanel>
                    </Border>
                </StackPanel>

                <!-- 5 Done -->
                <StackPanel x:Name="DonePanel" Visibility="Collapsed">
                    <Border Style="{StaticResource Card}" Padding="24,22" Margin="0,0,0,14">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE930;" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,8"
                                       Foreground="{DynamicResource SystemFillColorSuccessBrush}" />
                            <TextBlock x:Name="DoneTitle" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                                       AutomationProperties.LiveSetting="Assertive" AutomationProperties.HeadingLevel="Level1" />
                            <TextBlock x:Name="DoneSub" FontSize="14" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,4,0,8"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <WrapPanel HorizontalAlignment="Center">
                                <TextBlock x:Name="DoneBefore" FontSize="26" TextDecorations="Strikethrough" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE72A;" FontSize="18" Margin="14,0" />
                                <TextBlock x:Name="DoneAfter" FontSize="32" FontWeight="Bold" VerticalAlignment="Center" Foreground="{DynamicResource SystemFillColorSuccessBrush}" />
                                <Border CornerRadius="12" Padding="10,2" Margin="14,0,0,0" VerticalAlignment="Center" Background="{DynamicResource SystemFillColorSuccessBackgroundBrush}">
                                    <TextBlock x:Name="DonePct" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource SystemFillColorSuccessBrush}" />
                                </Border>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Padding="0" Margin="0,0,0,14">
                        <StackPanel>
                            <DockPanel Margin="16,12">
                                <Button x:Name="RowFileButton" DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Click="RowFile_Click" VerticalAlignment="Center" />
                                <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="&#xE8A5;" FontSize="20" Margin="0,0,14,0" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="RowFileName" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock x:Name="RowFileSub" Style="{StaticResource Secondary}" />
                                </StackPanel>
                            </DockPanel>
                            <Border x:Name="RowOrigLine" Height="1" Background="{DynamicResource DividerStrokeColorDefaultBrush}" />
                            <DockPanel x:Name="RowOrig" Margin="16,12">
                                <Button x:Name="RowOrigButton" DockPanel.Dock="Right" Click="RowOrig_Click" MinHeight="32" Padding="12,4" VerticalAlignment="Center" />
                                <TextBlock x:Name="RowOrigIcon" DockPanel.Dock="Left" Style="{StaticResource Icon}" FontSize="20" Margin="0,0,14,0" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="RowOrigName" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock x:Name="RowOrigSub" Style="{StaticResource Secondary}" />
                                </StackPanel>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <Border Padding="14,10" CornerRadius="6" BorderThickness="1" Background="{DynamicResource SystemFillColorAttentionBackgroundBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="&#xE946;" FontSize="16" Margin="0,0,10,0" VerticalAlignment="Top"
                                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock x:Name="DoneNote" FontSize="13" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                        </DockPanel>
                    </Border>
                </StackPanel>

                <!-- Problems, in plain words -->
                <Border x:Name="ErrorPanel" Visibility="Collapsed" Padding="14,10" CornerRadius="6" BorderThickness="1" Margin="0,14,0,0"
                        BorderBrush="{DynamicResource SystemFillColorCriticalBrush}" Background="{DynamicResource SystemFillColorCriticalBackgroundBrush}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="&#xE783;" Margin="0,0,10,0" VerticalAlignment="Top"
                                   Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
                        <TextBlock x:Name="ErrorText" TextWrapping="Wrap" FontSize="13" AutomationProperties.LiveSetting="Assertive" />
                    </DockPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Commands: the main action on the right, Close/Cancel last (Microsoft dialog order) -->
        <Border Grid.Row="1" Padding="28,12" BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" Background="{DynamicResource LayerFillColorDefaultBrush}">
            <DockPanel>
                <Button x:Name="LeftButton" DockPanel.Dock="Left" Click="Left_Click" MinHeight="32" Padding="12,4" Margin="0,0,12,0" Visibility="Collapsed" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="PrimaryButton" Click="Primary_Click" MinHeight="32" MinWidth="96" Padding="16,4" Margin="0,0,8,0"
                            Style="{DynamicResource AccentButtonStyle}" />
                    <Button x:Name="CloseButton" IsCancel="True" Click="Close_Click" MinHeight="32" MinWidth="96" Padding="12,4" />
                </StackPanel>
                <TextBlock x:Name="HintText" Style="{StaticResource Secondary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
