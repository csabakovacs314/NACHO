<Window x:Class="Nacho.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:Nacho"
        Title="{l:L About.Title}" Width="580" SizeToContent="Height" MinWidth="420"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="NoResize">
    <Window.Resources>
        <Style x:Key="Secondary" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="Step" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
    </Window.Resources>

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Margin="24,20,24,16">
            <DockPanel>
                <Viewbox DockPanel.Dock="Left" Width="56" Height="56" VerticalAlignment="Top">
                    <Canvas Width="20" Height="20">
                        <Polygon Points="10,2 19,17 1,17" Fill="#E8A33D" Stroke="#8A5000" StrokeThickness="1.5" StrokeLineJoin="Round" />
                        <Polygon Points="10,9 13.5,15 6.5,15" Fill="White" />
                    </Canvas>
                </Viewbox>
                <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="NACHO" FontSize="26" FontWeight="SemiBold" />
                    <TextBlock Text="{l:L App.Expansion}" FontSize="15" TextWrapping="Wrap" />
                    <TextBlock x:Name="OtherExpansion" Style="{StaticResource Secondary}" FontStyle="Italic" FontSize="13" />
                </StackPanel>
            </DockPanel>
            <TextBlock x:Name="VersionText" Style="{StaticResource Secondary}" FontSize="13" Margin="0,12,0,18" />

            <TextBlock Text="{l:L About.How}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" />
            <TextBlock Style="{StaticResource Step}"><Run Text="1. " /><Run Text="{l:L About.Way1}" /></TextBlock>
            <TextBlock Style="{StaticResource Step}"><Run Text="2. " /><Run Text="{l:L About.Way2}" /></TextBlock>
            <TextBlock Style="{StaticResource Step}"><Run Text="3. " /><Run Text="{l:L About.Way3}" /></TextBlock>
            <TextBlock Style="{StaticResource Step}"><Run Text="4. " /><Run Text="{l:L About.Way4}" /></TextBlock>

            <TextBlock Text="{l:L About.Replace}" FontSize="16" FontWeight="SemiBold" Margin="0,12,0,8" />
            <TextBlock Text="{l:L About.ReplaceBody}" TextWrapping="Wrap" />

            <TextBlock Text="{l:L About.Keys}" FontSize="16" FontWeight="SemiBold" Margin="0,12,0,8" />
            <TextBlock Text="{l:L About.KeysList}" TextWrapping="Wrap" FontSize="13" />

            <TextBlock Text="{l:L About.Credits}" Style="{StaticResource Secondary}" FontSize="13" Margin="0,18,0,0" />
        </StackPanel>

        <Border Grid.Row="1" Padding="24,12" BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                Background="{DynamicResource LayerFillColorDefaultBrush}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{l:L About.OpenFolder}" Click="OpenFolder_Click" MinHeight="32" Padding="12,4" Margin="0,0,8,0" />
                <Button Content="{l:L About.Close}" IsDefault="True" IsCancel="True" MinHeight="32" MinWidth="96" Padding="12,4"
                        Style="{DynamicResource AccentButtonStyle}" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
