<Window x:Class="Nacho.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:Nacho"
        Title="{l:L About.Title}" Width="640" SizeToContent="Height" MinWidth="420" MaxHeight="820"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="NoResize">
    <Window.Resources>
        <Style x:Key="AboutCard" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>
        <Style x:Key="Body" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="LineHeight" Value="19" />
        </Style>
        <Style x:Key="SubHeading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
    </Window.Resources>

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="True">
            <StackPanel Margin="24,22,24,10">
                <DockPanel Margin="0,0,0,14">
                    <Image DockPanel.Dock="Left" Source="{StaticResource Logo}" Width="64" Height="64" VerticalAlignment="Top"
                           AutomationProperties.Name="NACHO" />
                    <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="NACHO" FontSize="26" FontWeight="Bold" />
                        <TextBlock Text="{l:L App.Expansion}" FontSize="14" TextWrapping="Wrap" />
                        <TextBlock x:Name="OtherExpansion" Style="{StaticResource Secondary}" FontStyle="Italic" />
                    </StackPanel>
                </DockPanel>

                <!-- Version: neutral until checked, then green (newest), blue (newer one out) or amber (could not check) -->
                <Border x:Name="VersionStrip" Padding="14,8" Margin="0,0,0,14" CornerRadius="6" BorderThickness="1"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                    <DockPanel>
                        <TextBlock x:Name="VersionIcon" DockPanel.Dock="Left" Style="{StaticResource Icon}" FontSize="18" Margin="0,0,12,0" Text="&#xE946;"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="ReleaseButton" Content="{l:L Update.Open}" Click="Release_Click" MinHeight="32" Padding="12,4"
                                    Margin="8,0,0,0" Visibility="Collapsed" Style="{DynamicResource AccentButtonStyle}" />
                            <Button x:Name="CheckButton" Content="{l:L Update.CheckNow}" Click="Check_Click" MinHeight="32" Padding="12,4" Margin="8,0,0,0" />
                        </StackPanel>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="VersionText" FontSize="13" FontWeight="SemiBold" />
                            <TextBlock x:Name="CheckText" Style="{StaticResource Body}" Visibility="Collapsed" AutomationProperties.LiveSetting="Polite" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <Border Style="{StaticResource AboutCard}" BorderThickness="2" BorderBrush="{DynamicResource AccentFillColorDefaultBrush}" Padding="17,15">
                    <StackPanel>
                        <TextBlock Text="{l:L About.Google}" Style="{StaticResource Heading}" />
                        <TextBlock Text="{l:L About.GoogleBody}" Style="{StaticResource Body}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource AboutCard}">
                    <StackPanel>
                        <TextBlock Text="{l:L About.How}" Style="{StaticResource Heading}" />
                        <StackPanel x:Name="WaysList" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource AboutCard}">
                    <StackPanel>
                        <TextBlock Text="{l:L About.Replace}" Style="{StaticResource SubHeading}" />
                        <TextBlock Text="{l:L About.ReplaceBody}" Style="{StaticResource Body}" Margin="0,0,0,12" />
                        <TextBlock Text="{l:L About.Doc}" Style="{StaticResource SubHeading}" />
                        <TextBlock Text="{l:L About.DocBody}" Style="{StaticResource Body}" Margin="0,0,0,12" />
                        <TextBlock Text="{l:L About.Pdf}" Style="{StaticResource SubHeading}" />
                        <TextBlock Text="{l:L About.PdfBody}" Style="{StaticResource Body}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource AboutCard}">
                    <StackPanel>
                        <TextBlock Text="{l:L About.Keys}" Style="{StaticResource Heading}" />
                        <UniformGrid x:Name="KeysGrid" Columns="2" />
                    </StackPanel>
                </Border>

                <TextBlock Style="{StaticResource Secondary}" Margin="2,2,0,0">
                    <Run Text="{l:L About.Credits}" /><Run Text=" · " /><Hyperlink x:Name="PrivacyLink" Click="Privacy_Click"
                        Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"><Run Text="{l:L About.Privacy}" /></Hyperlink>
                </TextBlock>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1" Style="{StaticResource CommandBar}">
            <DockPanel>
                <Button DockPanel.Dock="Left" Content="{l:L About.OpenFolder}" Click="OpenFolder_Click" MinHeight="32" Padding="12,4" />
                <Button DockPanel.Dock="Right" Content="{l:L About.Close}" IsDefault="True" IsCancel="True" MinHeight="32" MinWidth="96" Padding="12,4"
                        HorizontalAlignment="Right" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
