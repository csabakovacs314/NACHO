<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>NACHO</AssemblyName>
    <RootNamespace>Nacho</RootNamespace>
    <ApplicationIcon>nacho.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Nacho.Core\Nacho.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- oxipng (MIT), unpacked once to %LOCALAPPDATA%\NACHO\tools; see tools\oxipng\README.md. -->
    <EmbeddedResource Include="..\..\tools\oxipng\win-x64\oxipng.exe" LogicalName="oxipng.exe" />
  </ItemGroup>
</Project>
